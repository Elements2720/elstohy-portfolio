# Browser configuration (Firebase web keys are public; Security Rules authorize access).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional local development only; never used in production builds.
NEXT_PUBLIC_AUTH_EMULATOR_URL=
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
# Server configuration. FIREBASE_PROJECT_ID must match the browser project.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Absolute production origin, without trailing slash.
SITE_URL=http://localhost:3000
