  "components": [
    {"name": "Experience filled pill", "kind": "button", "refersTo": "public-pill", "description": "Public contact action; Inter inherited by ordinary pills.", "html": "<a class=\"ds-public-pill\" href=\"#contact\">CONTACT NOW</a>", "css": ".ds-public-pill{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:white;color:#050505;border:1px solid white;border-radius:999px;font-family:PortoText,Arial,Helvetica,sans-serif;font-weight:700;font-size:16px;min-height:48px;padding:12px 24px;text-decoration:none;transition:background .25s,color .25s}.ds-public-pill:hover{background:#080808;color:#fff}.ds-public-pill:focus-visible{outline:2px solid #c2ff72;outline-offset:5px}@media(max-width:600px){.ds-public-pill{font-size:12px;min-height:38px;padding:10px 16px}}@media(prefers-reduced-motion:reduce){.ds-public-pill{transition:none}}"},
    {"name": "Experience outline pill", "kind": "button", "refersTo": "public-pill-outline", "description": "Header contact action on the dark public surface.", "html": "<a class=\"ds-public-outline\" href=\"#contact\">CONTACT NOW</a>", "css": ".ds-public-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:transparent;color:white;border:2px solid white;border-radius:999px;font-family:PortoDisplay,Arial,sans-serif;font-weight:700;font-size:16px;min-height:48px;padding:12px 24px;text-decoration:none;transition:background .25s,color .25s}.ds-public-outline:hover{background:white;color:#050505}.ds-public-outline:focus-visible{outline:2px solid #c2ff72;outline-offset:5px}@media(max-width:600px){.ds-public-outline{font-size:12px;min-height:38px;padding:10px 16px}}@media(prefers-reduced-motion:reduce){.ds-public-outline{transition:none}}"},
    {"name": "Experience four-dot menu", "kind": "nav", "description": "Canonical public navigation trigger; preview does not open a runtime menu.", "html": "<button class=\"ds-dot-menu\" aria-label=\"Open navigation\" aria-expanded=\"false\"><span></span><span></span><span></span><span></span></button>", "css": ".ds-dot-menu{width:42px;height:42px;display:grid;grid-template:repeat(2,4px)/repeat(2,4px);place-content:center;gap:10px;background:transparent;border:0;color:inherit;cursor:pointer}.ds-dot-menu span{width:4px;height:4px;background:white;border-radius:100%}.ds-dot-menu:hover span{background:#c2ff72}.ds-dot-menu:focus-visible{outline:2px solid #c2ff72;outline-offset:5px}"},
    {"name": "Operate primary button", "kind": "button", "refersTo": "admin-button", "description": "Dashboard save/publish action.", "html": "<button class=\"ds-admin-primary\">Save project</button>", "css": ".ds-admin-primary{display:inline-flex;align-items:center;justify-content:center;background:var(--admin-accent,#234738);color:white;border:1px solid var(--admin-accent,#234738);border-radius:6px;padding:11px 16px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:600;min-height:40px;white-space:nowrap;cursor:pointer}.ds-admin-primary:hover{background:#163829}.ds-admin-primary:focus-visible{outline:2px solid #2a6445;outline-offset:3px}.ds-admin-primary:disabled{cursor:not-allowed;opacity:.55}"},
    {"name": "Operate secondary button", "kind": "button", "refersTo": "admin-button-secondary", "description": "Secondary editing and navigation actions.", "html": "<button class=\"ds-admin-secondary\">All projects</button>", "css": ".ds-admin-secondary{display:inline-flex;align-items:center;justify-content:center;background:white;color:#344439;border:1px solid #ccd5cc;border-radius:6px;padding:11px 16px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:600;min-height:40px;white-space:nowrap;cursor:pointer}.ds-admin-secondary:hover{background:#edf2ea}.ds-admin-secondary:focus-visible{outline:2px solid #2a6445;outline-offset:3px}.ds-admin-secondary:disabled{cursor:not-allowed;opacity:.55}"},
    {"name": "Operate danger button", "kind": "button", "refersTo": "admin-button-danger", "description": "Destructive dashboard action, distinct from error messages.", "html": "<button class=\"ds-admin-danger\">Delete</button>", "css": ".ds-admin-danger{display:inline-flex;align-items:center;justify-content:center;background:transparent;color:#8c382b;border:1px solid #dac4bd;border-radius:6px;padding:11px 16px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:600;min-height:40px;white-space:nowrap;cursor:pointer}.ds-admin-danger:hover{background:#f9ede9}.ds-admin-danger:focus-visible{outline:2px solid #2a6445;outline-offset:3px}.ds-admin-danger:disabled{cursor:not-allowed;opacity:.55}"},
    {"name": "Operate text field", "kind": "input", "refersTo": "admin-field", "description": "Labeled editable value; no invented hover or invalid-field styling.", "html": "<label class=\"ds-admin-field\"><span>Project title *</span><input type=\"text\" required></label>", "css": ".ds-admin-field{display:flex;flex-direction:column;gap:8px;margin-bottom:22px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:600;min-width:0}.ds-admin-field input{background:#fff;border:1px solid #b9c4ba;color:#253027;width:100%;border-radius:5px;padding:11px 12px;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:400;min-height:42px}.ds-admin-field input:focus-visible{outline:2px solid #2a6445;outline-offset:3px}"},
    {"name": "Operate panel", "kind": "card", "refersTo": "admin-panel", "description": "Bordered, shadowless editor surface.", "html": "<section class=\"ds-admin-panel\"><h2>Project content</h2></section>", "css": ".ds-admin-panel{padding:30px;background:#fff;color:#202822;border:1px solid var(--admin-line,#d8ddd7);border-radius:9px;margin-bottom:25px;font-family:Arial,Helvetica,sans-serif}.ds-admin-panel h2{margin:0;font-size:21px;letter-spacing:-.02em}@media(max-width:850px){.ds-admin-panel{padding:24px}}@media(max-width:650px){.ds-admin-panel{padding:20px 16px}}"},
    {"name": "Operate badges", "kind": "chip", "refersTo": "admin-badge", "description": "Static record labels with a dedicated published state.", "html": "<span class=\"ds-admin-badge\">Draft</span><span class=\"ds-admin-badge ds-admin-published\">Published</span>", "css": ".ds-admin-badge{display:inline-block;font-family:Arial,Helvetica,sans-serif;font-size:10px;background:#f0f2ed;color:#596252;padding:4px 8px;border-radius:4px;margin:6px 6px 0 0;text-transform:capitalize}.ds-admin-published{background:#e3efe0;color:#35602c}"},
    {"name": "Operate sidebar navigation", "kind": "nav", "description": "Dashboard navigation selected and hover states; mobile shell behavior remains in application code.", "html": "<nav class=\"ds-admin-nav\" aria-label=\"Dashboard navigation\"><a href=\"#overview\">Overview</a><a href=\"#projects\" class=\"ds-admin-selected\" aria-current=\"page\">Projects</a></nav>", "css": ".ds-admin-nav{display:flex;flex-direction:column;gap:4px;background:white;font-family:Arial,Helvetica,sans-serif}.ds-admin-nav a{padding:12px 15px;border-radius:7px;font-size:14px;color:#59625b;text-decoration:none}.ds-admin-nav a.ds-admin-selected{background:#eaf0e8;color:#244333;font-weight:700}.ds-admin-nav a:hover{background:#f0f3ee}.ds-admin-nav a:focus-visible{outline:2px solid #2a6445;outline-offset:3px}@media(max-width:650px){.ds-admin-nav a{padding:11px 15px}}"}
  ],
  "narrative": {
    "northStar": "Experience / Operate",
    "overview": "Experience reconstructs the user-pinned Porto source: oversized fitted identity, a near-black checker ground, fine vertical rails, restrained metadata and asymmetric media rhythm. Real app screenshot compositions take the place of source photography; this is source-site reconstruction, not a generated comp.\n\nOperate is a separate light, dense editorial workspace for the single owner. White bordered panels, green actions and conventional form typography prioritize editing and publishing. Public display typography, checker texture and custom cursor do not define dashboard controls.",
    "keyCharacteristics": ["Fitted public identity with an explicit full-name caption.", "Real product imagery inside rounded, unframed editorial work compositions.", "Separate light dashboard with green actions and visible field boundaries.", "Source-extracted tokens; surface-specific responsive and motion behavior."],
    "rules": [
      {"name": "The Separate Surfaces Rule", "body": "Keep Experience's dark editorial palette and Operate's light functional palette scoped to their own surfaces.", "section": "colors"},
      {"name": "The Measured Identity Rule", "body": "Fit the actual identity after font loading and on resize; never copy Porto's five-letter display size onto a longer name.", "section": "typography"}
    ],
    "dos": ["Do keep Experience and Operate surface rules separate.", "Do use Clash Display 600 for public headings, Clash Display 500 for public metadata, and Inter for public body copy.", "Do fit long identity text and retain the explicit full name.", "Do use real, sourced product screenshots and factual descriptions.", "Do preserve visible keyboard focus, selected-tab visibility and reduced-motion behavior."],
    "donts": ["Don't replace Porto's public editorial media rhythm with conventional developer hero/card composition.", "Don't invent awards, testimonials, pricing, employer names, personal geography or phone numbers.", "Don't generate a human portrait or treat this reconstruction as a generated comp.", "Don't turn project artwork grounds into global brand colors or add dashboard panel shadows.", "Don't canonize existing text-glyph arrows, reorder glyph controls, the decorative asterisk or the dashboard system-font brand as reusable display/icon prescriptions; these observed craft-floor exceptions remain unrepaired within this documentation-only boundary."]
  }
}
